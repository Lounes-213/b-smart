{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bs-ai-gateway",
  "main": "./src/worker.ts",
  "account_id": "564581154699f9f3cc7813bdc34c7e33",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "AI_DAILY_BUDGET_MICROS": "500000",
    "AI_MODELS": "google/gemini-3.1-flash-lite,inception/mercury-2.5",
    "AI_TRANSCRIBE_MODELS": "microsoft/mai-transcribe-2,openai/whisper-large-v3-turbo",
    "AI_UPSTREAM_BASE_URL": "https://openrouter.ai/api/v1",
  },
  "secrets": { "required": ["OPENROUTER_API_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bs-connect",
      "database_id": "5b6c3bac-1f9f-430c-9143-8148738751c6",
      "migrations_dir": "../../packages/connect-db/migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "routes": [],
  "env": {
    "staging": {
      "workers_dev": false,
      "vars": {
        "AI_DAILY_BUDGET_MICROS": "500000",
        "AI_MODELS": "google/gemini-3.1-flash-lite,inception/mercury-2.5",
        "AI_TRANSCRIBE_MODELS": "microsoft/mai-transcribe-2,openai/whisper-large-v3-turbo",
        "AI_UPSTREAM_BASE_URL": "https://openrouter.ai/api/v1",
      },
      "secrets": { "required": ["OPENROUTER_API_KEY"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bs-connect",
          "database_id": "5b6c3bac-1f9f-430c-9143-8148738751c6",
          "migrations_dir": "../../packages/connect-db/migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "4202",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      "routes": [
        {
          "pattern": "vibecodethis.site/api/ai/*",
          "zone_name": "vibecodethis.site",
        },
      ],
    },
  },
}
