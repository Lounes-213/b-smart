// bb connect — tunnel gate worker + TunnelDO.
//
// The gate resolves `<handle>.<BASE_DOMAIN>` to a server row in D1, authenticates
// the tunnel client by durable credential and visitors by better-auth session,
// then proxies through the per-handle TunnelDO. Staging serves per-handle custom
// domains attached on demand (e.g. sawyer.vibecodethis.site).
//
// Deploy prod:    pnpm --filter @bb/connect exec wrangler deploy
// Deploy staging: pnpm --filter @bb/connect exec wrangler deploy --env staging
// Secret: wrangler secret put BETTER_AUTH_SECRET [--env staging]
//         (must equal bb-web's BETTER_AUTH_SECRET — the gate verifies the
//         session cookie's HMAC with it)
// Secret: wrangler secret put GATE_SECRET [--env staging]
//         (bearer token of the bb connect next Fly gate for
//         POST https://connect.getbb.app/api/gate/resolve and /api/gate/presence;
//         must equal the Fly app's GATE_SECRET. Unset = both answer 404.)
// Var: NEXT_BASE_DOMAIN — the bb connect next domain (next.getbb.app); MCP
//         OAuth tokens for https://<label>.<NEXT_BASE_DOMAIN>/mcp resolve only
//         through /api/gate/resolve.
// Optional var: ASSETLINKS_SHA256_FINGERPRINTS — comma-separated Android
//         signing-cert fingerprints for /.well-known/assetlinks.json (bb
//         mobile app links). Unset until the Android app is signed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bs-connect",
  "main": "./src/worker.ts",
  "account_id": "564581154699f9f3cc7813bdc34c7e33",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }],
  },
  // Production: every *.getbb.app subdomain hits the gate via the wildcard
  // zone route (backed by a proxied `*` DNS record). The apex + www are
  // custom domains on bb-web and take precedence over this route.
  "vars": {
    "BASE_DOMAIN": "getbb.app",
    "NEXT_BASE_DOMAIN": "next.getbb.app",
    "PRESENCE_WRITES": "on-change",
    "WORKER_HELD_RESPONSES": "on",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bs-connect",
      "database_id": "5b6c3bac-1f9f-430c-9143-8148738751c6",
      // Shared schema lives in connect-db; CI runs `wrangler d1 migrations
      // apply DB --remote` from this config before every deploy (the
      // d1_migrations tracking tables were seeded with the hand-applied
      // 0000-000N chain on 2026-07-08).
      "migrations_dir": "../../packages/connect-db/migrations",
    },
  ],
  // "analytics_engine_datasets": disabled
  "workers_dev": true,
  "routes": [],
  "env": {
    "staging": {
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
      "durable_objects": {
        "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }],
      },
      "vars": {
        "BASE_DOMAIN": "vibecodethis.site",
        "NEXT_BASE_DOMAIN": "next.vibecodethis.site",
        "WORKER_HELD_RESPONSES": "on",
        "PRESENCE_WRITES": "on-change",
      },
      // Staging now has a dashboard-managed wildcard (`*.vibecodethis.site`
      // proxied DNS + zone route to this worker, added 2026-07-08), matching
      // prod's model — new labels/share hosts need no per-host config. The
      // legacy per-host custom domains below predate the wildcard and take
      // precedence over it; they stay declared so a staging deploy never
      // inherits the top-level prod routes (routes inherit across wrangler
      // envs — the same footgun that once stole a domain from bb-web).
      // NOTE: the zone route itself is dashboard-managed because this
      // machine's wrangler token is zone read-only and cannot write routes.
      "routes": [
        { "pattern": "sawyer.vibecodethis.site", "custom_domain": true },
        { "pattern": "sawyer--8000.vibecodethis.site", "custom_domain": true },
        { "pattern": "sawyer--8099.vibecodethis.site", "custom_domain": true },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bb-connect-staging",
          "database_id": "1aaa5562-457d-43a7-b11f-18b4f19bd62c",
          "migrations_dir": "../../packages/connect-db/migrations",
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "GATE_EVENTS",
          "dataset": "bb_connect_gate_events_staging",
        },
      ],
    },
  },
}
