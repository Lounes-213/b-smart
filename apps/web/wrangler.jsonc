// getbb.app site — marketing page + bb connect auth/dashboard, TanStack Start on Workers.
//
// Top level = staging (vibecodethis.site); env.production = prod (getbb.app).
// The @cloudflare/vite-plugin resolves the environment at BUILD time via
// CLOUDFLARE_ENV (not `wrangler deploy --env`): the build writes the resolved
// config to dist/server/wrangler.json and a plain `wrangler deploy` follows
// the .wrangler/deploy/config.json redirect to it.
//
// Deploy staging: pnpm --filter @bb/web build && pnpm --filter @bb/web exec wrangler deploy
// Deploy prod:    CLOUDFLARE_ENV=production pnpm --filter @bb/web build
//                 && pnpm --filter @bb/web exec wrangler deploy
// Secrets (per worker): wrangler secret put [--name bb-web] GITHUB_CLIENT_ID /
//   GITHUB_CLIENT_SECRET / BETTER_AUTH_SECRET / LANDING_POSTHOG_KEY / RESEND_API_KEY
// Var: NEXT_BASE_DOMAIN — bb connect next's domain; /oauth/authorize also
//   issues MCP tokens for https://<label>.<NEXT_BASE_DOMAIN>/mcp.
// Var: GATE_PUBLIC_KEYS — the bb connect next gate's Ed25519 public key set
//   as a JSON string ({"keys":[{"kid","kty":"OKP","crv":"Ed25519","x"}]}),
//   served at /.well-known/bb-connect-gate-keys.json. Unset = 404. It is
//   public, so it lives in "vars" here (not the dashboard: a deploy replaces
//   dashboard vars). Staging holds the staging gate's key (kid
//   staging-2026-10-20), production the production gate's (kid
//   prod-2026-10-21); the private halves are the gates' GATE_SIGNING_KEY
//   Fly secrets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bs-web",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server-entry.ts",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "BASE_DOMAIN": "azar-neg.workers.dev",
    "APP_URL": "https://bs-web.azar-neg.workers.dev",
    // Resend audience that /api/subscribe adds emails to ("bb users").
    // Not a secret — only the API key is.
    "RESEND_AUDIENCE_ID": "299db4ee-f3db-476d-9847-0bf4344d9c44",
    "PRESENCE_WRITES": "on-change",
    "NEXT_BASE_DOMAIN": "next.vibecodethis.site",
    "GATE_PUBLIC_KEYS": "{\"keys\":[{\"kid\":\"staging-2026-10-20\",\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"R5uinj0FFjpFtS9QHKb7LY7wsPo9RZkoRRsxegheihw\"}]}",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bs-connect",
      "database_id": "5b6c3bac-1f9f-430c-9143-8148738751c6",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL_DO",
        "class_name": "TunnelDO",
        "script_name": "bs-connect",
      },
    ],
  },
  // BB Official plugin marketplace. The registry repo (get-bb/marketplace)
  // uploads marketplace.json + icons here; /marketplace/v1/* serves them.
  // The route answers 404 until the bucket exists, so this binding can land
  // before the bucket is provisioned.
  "r2_buckets": [
    {
      "binding": "MARKETPLACE",
      "bucket_name": "bs-marketplace",
    },
  ],
  // ratelimits commented out
  // "ratelimits": [ ... ]
  "routes": [],
  "env": {
    // Production (getbb.app). Cutover note: the getbb.app + www custom domains
    // move here from the old bb-landing worker; until then workers_dev gives a
    // preview URL. `www` is handled by the gate's reserved-handle redirect.
    "production": {
      "name": "bs-web-prod",
      "workers_dev": true,
      "observability": { "enabled": true },
      // Override the inherited staging custom domain; prod domains attach at
      // cutover. Never leave this to inheritance — a prod deploy would steal
      // vibecodethis.site from bb-web-staging.
      "routes": [],
      "secrets": {
        "required": [
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "BETTER_AUTH_SECRET",
          "LANDING_POSTHOG_KEY",
          "RESEND_API_KEY",
        ],
      },
      "vars": {
        "BASE_DOMAIN": "getbb.app",
        "APP_URL": "https://getbb.app",
        "PRESENCE_WRITES": "on-change",
        "NEXT_BASE_DOMAIN": "next.getbb.app",
        "GATE_PUBLIC_KEYS": "{\"keys\":[{\"kid\":\"prod-2026-10-21\",\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"sSHHgGnUQNXtsJ2_4EDXj4ZpIq9y45fZDvMGkKsWnGU\"}]}",
        "RESEND_AUDIENCE_ID": "299db4ee-f3db-476d-9847-0bf4344d9c44",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bs-connect",
          "database_id": "5b6c3bac-1f9f-430c-9143-8148738751c6",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "TUNNEL_DO",
            "class_name": "TunnelDO",
            "script_name": "bs-connect",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "MARKETPLACE",
          "bucket_name": "bb-marketplace",
        },
      ],
      "ratelimits": [
        {
          "name": "LINK_START_RATE_LIMITER",
          "namespace_id": "4204",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
